@startuml Architectural_Design
!theme plain
skinparam componentStyle rectangle
skinparam linetype ortho

title Attendeely System - Architectural Design Diagram

' ============================================
' High-Level Architecture
' ============================================
@startuml High_Level_Architecture
title High-Level System Architecture

package "Client Layer" {
    [Web Frontend] as WebFrontend
    [Mobile Apps] as MobileApps
}

package "API Layer" {
    component [FastAPI Application] as FastAPI {
        component [API Routes] as Routes
        component [Middleware] as Middleware
        component [Dependencies] as Dependencies
    }
}

package "Application Layer" {
    component [Business Logic] as BusinessLogic {
        component [Services] as Services
        component [Utils] as Utils
        component [Security] as Security
    }
}

package "Data Access Layer" {
    component [SQLAlchemy ORM] as ORM {
        component [Models] as Models
        component [Queries] as Queries
    }
}

package "Database Layer" {
    database "PostgreSQL" as PostgreSQL
}

package "External Services" {
    cloud "Fapshi\nPayment Gateway" as Fapshi
    cloud "Cloudinary\nImage Storage" as Cloudinary
    cloud "Resend\nEmail Service" as Resend
}

' Client to API
WebFrontend --> Routes : HTTP/REST
MobileApps --> Routes : HTTP/REST

' API Layer
Routes --> Middleware : Request Processing
Middleware --> Dependencies : Dependency Injection
Dependencies --> Security : Authentication/Authorization

' Application Layer
Routes --> BusinessLogic : Business Logic
BusinessLogic --> Services : Service Calls
BusinessLogic --> Utils : Utility Functions
Security --> BusinessLogic : Access Control

' Data Access
BusinessLogic --> ORM : Data Operations
ORM --> Models : Model Definitions
ORM --> Queries : Database Queries

' Database
ORM --> PostgreSQL : SQL Queries
PostgreSQL --> ORM : Query Results

' External Services
Services --> Fapshi : Payment API
Services --> Cloudinary : Image API
Services --> Resend : Email API

Fapshi --> Routes : Webhooks
Cloudinary --> Services : Image URLs
Resend --> Services : Email Confirmations

note right of FastAPI
  **FastAPI Application**
  - RESTful API Endpoints
  - Request/Response Handling
  - Error Handling
  - CORS Configuration
end note

note right of BusinessLogic
  **Business Logic Layer**
  - Feature Access Control
  - Subscription Management
  - Payment Processing
  - Notification Creation
end note

note right of ORM
  **Data Access Layer**
  - SQLAlchemy ORM
  - Relationship Management
  - Transaction Handling
  - Query Optimization
end note

@enduml

' ============================================
